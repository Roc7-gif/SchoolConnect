SECRET_KEY=changeme-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon (Postgres serverless) — copier la "Connection string" depuis le dashboard Neon
# Format: postgres://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxxxx.region.aws.neon.tech/schoolconnect_db?sslmode=require

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (canal EMAIL des messages) — Resend via django-anymail.
# Sans clé, les emails s'affichent dans la console au lieu d'être envoyés.
# DEFAULT_FROM_EMAIL doit utiliser un domaine vérifié dans votre compte Resend.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=SchoolConnect <onboarding@resend.dev>

# Canaux sans passerelle (SMS, WhatsApp) : 'fail' (défaut) les fait échouer, la cascade
# retombe alors sur l'email réellement envoyé. 'success' les fait réussir sans rien envoyer.
SIMULATE_UNWIRED_CHANNELS=fail

# Mode IA de l'import (data_import) — laisser vide pour désactiver, le mode standard reste utilisable.
# Actuellement un proxy tiers (HighwayAPI, compatible OpenAI) en attendant une vraie clé Anthropic —
# voir data_import/ai_parser.py. Ne pas y envoyer de vraies données élèves/parents en production.
AI_PROXY_API_KEY=
AI_PROXY_BASE_URL=https://api.highwayapi.ai/openai
